{
  "name": "panel-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --experimental-test-isolation=none src/lib/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles deb",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "check": "npm run format:check && npm test && npm run build && npm run rust:fmt && npm run rust:test && npm run rust:clippy"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
